# ---------------------------------------------------------------------------
# StatusWatch API configuration
# Copy to server/.env and adjust. Never commit the real .env.
# ---------------------------------------------------------------------------

NODE_ENV=development
PORT=4000
HOST=0.0.0.0

# Comma-separated list of browser origins allowed to call the API. Use * to allow any.
CORS_ORIGIN=http://localhost:5173

# --- Database --------------------------------------------------------------
# Either set DATABASE_URL (takes precedence, typical for RDS / managed Postgres)…
# DATABASE_URL=postgresql://statuswatch:statuswatch@localhost:5432/statuswatch
# …or the individual PG* variables below.
PGHOST=localhost
PGPORT=5432
PGDATABASE=statuswatch
PGUSER=statuswatch
PGPASSWORD=change-me
# Set to true when the database requires TLS (e.g. AWS RDS).
PGSSL=false
PG_POOL_MAX=10

# --- Auth ------------------------------------------------------------------
# Generate a long random value, e.g.:  openssl rand -hex 32
JWT_SECRET=replace-with-a-long-random-string
JWT_EXPIRES_IN=12h

ADMIN_USERNAME=admin

# Preferred: a bcrypt hash produced by `npm run hash-password -- 'your-password'`.
# ADMIN_PASSWORD_HASH=$2b$12$replace.this.with.a.real.bcrypt.hash

# Local-development fallback, used only when ADMIN_PASSWORD_HASH is unset.
# Do not use this in a deployed environment.
ADMIN_PASSWORD=change-me

# --- Scheduler -------------------------------------------------------------
SCHEDULER_ENABLED=true
# 6-field cron (seconds first). Each tick probes every service whose own
# interval_seconds has elapsed since its last check.
SCHEDULER_CRON=*/30 * * * * *
CHECK_TIMEOUT_MS=10000
CHECK_CONCURRENCY=5
CHECK_USER_AGENT=StatusWatch/1.0 (+uptime-monitor)

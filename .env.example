# ---------------------------------------------------------------------------
# Environment for the production docker-compose.yaml.
# Copy to .env next to docker-compose.yaml and fill in. Never commit the real .env.
#
#   cp .env.example .env
# ---------------------------------------------------------------------------

# Credentials the Postgres container is initialised with on FIRST start.
# They are only read while the data volume is empty; changing them later does not
# rename an existing role or database.
#
# These must match PGUSER / PGPASSWORD / PGDATABASE in server/.env, which is how the
# backend connects. POSTGRES_USER must also match the `pg_isready -U ...` healthcheck
# in docker-compose.yaml.
POSTGRES_USER=statuswatch
POSTGRES_PASSWORD=change-me
POSTGRES_DB=statuswatch

# ---------------------------------------------------------------------------
# StatusWatch dashboard configuration
# Copy to client/.env for local development.
#
# Only VITE_-prefixed variables reach the browser bundle. They are baked in at
# BUILD time, not read at runtime — set them before `npm run build`.
# ---------------------------------------------------------------------------

# Base URL of the API. Leave unset locally: the app then calls the same origin
# ("/api") and the Vite dev server proxies it to VITE_DEV_API_PROXY below.
# In a deployed environment set the API's public URL, e.g.
# VITE_API_BASE_URL=https://status-api.example.com/api

# Where the Vite dev server forwards /api requests (development only).
VITE_DEV_API_PROXY=http://localhost:4000

# Dev server ports.
CLIENT_PORT=5173
CLIENT_PREVIEW_PORT=4173
